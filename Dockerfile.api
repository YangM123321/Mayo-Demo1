FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    MODE=api

WORKDIR /app

# Minimal deps (bash optional; keep only if you truly need it)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy app
COPY src/ /app/src/
COPY models/ /app/models/

# Optional (if you need mlflow DB file to exist)
RUN touch /app/mlflow.db

# Copy entrypoint
COPY entrypoint.sh /app/entrypoint.sh

# Fix Windows CRLF/BOM + make executable
RUN sed -i '1s/^\xEF\xBB\xBF//' /app/entrypoint.sh \
 && sed -i 's/\r$//' /app/entrypoint.sh \
 && chmod +x /app/entrypoint.sh

EXPOSE 8080

# IMPORTANT: run with sh, not bash
ENTRYPOINT ["/bin/sh", "/app/entrypoint.sh"]
